[Unit]
Description=jargonaut daemon (Haiku post-processing for Vocalinux dictation)

[Service]
Type=simple
# The launcher written by install.py; it runs the installed runtime in
# ~/.local/share/jargonaut/app, so this unit never changes.
ExecStart=%h/.local/bin/jargonaut-daemon
# ~/.local/bin first, so the claude CLI is found.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=5
# No extra sandboxing: claude needs the home directory (login, temp dirs).
NoNewPrivileges=yes

[Install]
WantedBy=default.target
