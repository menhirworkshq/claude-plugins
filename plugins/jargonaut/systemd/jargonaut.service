[Unit]
Description=jargonaut daemon (Haiku post-processing for Vocalinux dictation)

[Service]
Type=simple
# The launcher written by launchers.py: this unit does not change when the
# plugin moves or is updated, only the launcher does.
ExecStart=%h/.local/bin/jargonaut-daemon
# ~/.local/bin first, so the claude CLI is found.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=5
# No extra sandboxing: claude needs the home directory (login, temp dirs).
NoNewPrivileges=yes

[Install]
WantedBy=default.target
